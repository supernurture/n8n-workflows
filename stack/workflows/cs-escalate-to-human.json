          "additionalFields": {
            "appendAttribution": false,
            "parse_mode": "HTML",
            "disable_web_page_preview": true
          }
        },
        "credentials": {
          "telegramApi": {
            "id": "tgbcAmxqaWPvfvo7",
            "name": "Telegram CS Bot"
          }
        },
        "notes": "Customer text is HTML-escaped. A failed send is reported back to the agent instead of stopping the chat.",
        "retryOnFail": true,
        "onError": "continueRegularOutput",
        "webhookId": "f3b7d66b-a433-46de-9266-20328fcc9f22"
      },
