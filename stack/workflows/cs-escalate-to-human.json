                "name": "message",
                "type": "string",
                "value": "={{ $json.ok === true ? \"Permintaan sudah diteruskan ke admin.\" : \"Permintaan sudah dicatat, tetapi notifikasi ke admin gagal. Arahkan customer ke kontak resmi bisnis.\" }}"
              }
            ]
          }
        }
