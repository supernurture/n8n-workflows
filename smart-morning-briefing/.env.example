# n8n configuration system
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
# Nodes must not read environment variables (protects N8N_ENCRYPTION_KEY from Code nodes).
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
# REQUIRED: replace with a long random secret (e.g. `openssl rand -hex 32`) and back it up
# somewhere safe. Without it, stored credentials cannot be decrypted after a restore.
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Workflow parameters are NOT set here. Create an n8n Data Table named "Automation Settings"
# with string columns telegramChatId, quoteEndpoint, weatherEndpoint and exactly one row, e.g.:
#   quoteEndpoint   = https://dummyjson.com/quotes/random
#   weatherEndpoint = https://api.open-meteo.com/v1/forecast?latitude=-6.2088&longitude=106.8456&current_weather=true
# Also create "briefing_log" and "error_log" (see the Data Table nodes in the workflow JSON for columns).
