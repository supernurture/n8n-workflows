# n8n configuration system
GENERIC_TIMEZONE=Asia/Jakarta
TZ=Asia/Jakarta
# Workflows read endpoints/chat ID via $env, so env access in nodes must stay enabled.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# REQUIRED: replace with a long random secret (e.g. `openssl rand -hex 32`) and back it up
# somewhere safe. Without it, stored credentials cannot be decrypted after a restore.
N8N_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# workflow parameters
TELEGRAM_CHAT_ID=
QUOTE_ENDPOINT=https://dummyjson.com/quotes/random
# Daily forecast + timezone query params are added by the workflow itself.
WEATHER_ENDPOINT=https://api.open-meteo.com/v1/forecast?latitude=-6.2088&longitude=106.8456&current_weather=true
