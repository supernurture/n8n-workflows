      {
        "id": "04e276f8-dc7b-4f01-9b05-fbb67ab86760",
        "name": "Format Alert",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          224,
          0
        ],
        "parameters": {
          "mode": "runOnceForAllItems",
          "jsCode": "// Format Alert — normalises both Error Trigger payload shapes (execution error vs trigger error)\n// into one record, and renders a Telegram-safe HTML alert.\nconst TZ = 'Asia/Jakarta';\nconst MAX_MSG = 500; // pre-escape limit; worst-case escaping keeps the alert under Telegram's 4096 chars\n\nconst esc = (s) => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\nconst clip = (s, max) => {\n  const t = String(s ?? '').trim();\n  return t.length > max ? t.slice(0, max - 1) + '…' : t;\n};\n\nconst data = $input.first().json || {};\nconst wf = data.workflow || {};\nconst exec = data.execution || null;\nconst trig = data.trigger || null;\n\nconst isTriggerError = !exec && !!trig;\nconst err = (exec && exec.error) || (trig && trig.error) || {};\nconst message = clip(err.message || err.description || 'Unknown error (no message provided)', MAX_MSG);\nconst description = err.description && err.description !== err.message ? clip(err.description, 150) : '';\nconst failedNode = (exec && (exec.lastNodeExecuted || err.node?.name)) || err.node?.name || (isTriggerError ? 'Trigger' : 'unknown');\nconst errorType = err.name || (isTriggerError ? 'TriggerError' : 'ExecutionError');\nconst mode = (exec && exec.mode) || (trig && trig.mode) || 'unknown';\nconst executionId = exec && exec.id != null ? String(exec.id) : '';\nconst executionUrl = (exec && exec.url) || '';\nconst retryOf = exec && exec.retryOf ? String(exec.retryOf) : '';\n\nconst ts = err.timestamp ? DateTime.fromMillis(Number(err.timestamp)).setZone(TZ) : $now.setZone(TZ);\nconst when = (ts.isValid ? ts : $now.setZone(TZ)).toFormat('yyyy-MM-dd HH:mm:ss') + ' WIB';\n\nconst lines = [\n  `🚨 <b>WORKFLOW FAILED</b>${isTriggerError ? ' (trigger)' : ''}`,\n  '',\n  `<b>Workflow:</b> ${esc(wf.name || 'unknown')} <code>${esc(wf.id || '-')}</code>`,\n  `<b>Failed node:</b> ${esc(failedNode)}`,\n  `<b>Error:</b> ${esc(errorType)}`,\n  `<b>Message:</b> ${esc(message)}`,\n];\nif (description) lines.push(`<b>Details:</b> ${esc(description)}`);\nlines.push(`<b>Mode:</b> ${esc(mode)}`);\nlines.push(`<b>Time:</b> ${esc(when)}`);\nif (executionId) lines.push(`<b>Execution:</b> <code>${esc(executionId)}</code>${retryOf ? ` (retry of ${esc(retryOf)})` : ''}`);\nif (executionUrl) lines.push(`<a href=\"${esc(executionUrl)}\">Open execution</a>`);\n\nreturn [{\n  json: {\n    text: lines.join('\\n'),\n    occurred_at: (ts.isValid ? ts : $now).toISO(),\n    workflow_id: String(wf.id || ''),\n    workflow_name: String(wf.name || ''),\n    execution_id: executionId,\n    execution_url: executionUrl,\n    mode: String(mode),\n    failed_node: String(failedNode),\n    error_type: String(errorType),\n    error_message: message,\n  },\n}];\n"
        }
      },
