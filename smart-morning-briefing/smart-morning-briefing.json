    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const data = $input.item.json;\n\nconst quote  = data.quote;\nconst author = data.author;\nconst temp = data.current_weather?.temperature ?? \"N/A\";\nconst wind = data.current_weather?.windspeed ?? \"N/A\";\n\nlet weatherStatus = \"Cool / Cloudy ⛅\";\nif (typeof temp === \"number\") {\n  if (temp >= 31) weatherStatus = \"Scorching Heat ☀️\";\n  else if (temp < 25) weatherStatus = \"Cold / Rain 🌧️\";\n}\n\nconst bodyText = `🌤️ *Weather:* ${temp}°C (${weatherStatus}, Wind ${wind} km/h)\\n\\n💬 *\"${quote}\"*\\n— _${author}_`;\n\nreturn {\n  json: {\n    bodyText: bodyText,\n    charCount: bodyText.length\n  }\n};"
      },
